{
  "name": "siddesh-inventory-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Unified Siddesh ERP & Barcode Mobile App Monorepo",
  "workspaces": [
    "apps/desktop",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/desktop",
    "build": "npm run build --workspace apps/desktop",
    "package": "npm run package --workspace apps/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:start": "supabase start",
    "db:types": "node scripts/gen-db-types.mjs"
  },
  "dependencies": {
    "@supabase/server": "^1.4.0"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "electron": "^33.2.1",
    "prisma": "^7.8.0",
    "supabase": "2.98.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "optionalDependencies": {
    "@electron-internal/extract-zip-win32-x64-msvc": "npm:null@*"
  }
}

